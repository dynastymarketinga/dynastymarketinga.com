---
/** Home hero — same markup/classes as legacy (design frozen). */
---

<section id="hero">
  <div class="hero-bg-image" aria-hidden="true"></div>
  <div class="hero-bg-logo plx" data-spd="0.12" aria-hidden="true">
    <img src="/dynasty-hero-logo.png" alt="" />
  </div>
  <div class="hero-bg-circle plx" data-spd="0.25"></div>
  <div class="hero-bg-lines"></div>
  <div class="hero-top">
    <div class="hero-eyebrow">
      <div class="hero-badge">Full-Service Creative and AI Agency</div>
      <span class="hero-location">United States and Venezuela</span>
    </div>
    <div class="hero-headline">
      <h1 class="hero-h1">
        We build <span style="color:var(--gold)">brands</span> that lead
      </h1>
      <div class="hero-sub-area">
        <p class="hero-desc">
          Specializing in AI-driven automation and smart systems to optimize your business administration, combined with high-impact branding, social media, content creation, and performance marketing. We help brands grow from the inside out through intentional design, creative storytelling, and results-driven marketing
        </p>
        <div class="hero-cta-group">
          <a href="/contact" class="btn-hero"><span>Schedule a Call</span></a>
          <a href="/portfolio" class="btn-ghost">See our work</a>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-bottom">
    <div class="hero-stats">
      <div>
        <div class="hstat-num">10<span style="color:var(--gold)">+</span></div>
        <div class="hstat-lab">Clients</div>
      </div>
      <div>
        <div class="hstat-num">7<span style="color:var(--gold)">+</span></div>
        <div class="hstat-lab">Years of Experience</div>
      </div>
      <div>
        <div class="hstat-num">M<span style="color:var(--gold)">+</span></div>
        <div class="hstat-lab">Views Generated</div>
      </div>
    </div>
    <div class="hero-scroll-hint">
      <div class="scroll-track"></div>
      Scroll to explore
    </div>
  </div>
</section>
