---
/** Home hero — same markup/classes as legacy (design frozen). */
---

<section id="hero">
  <div class="hero-bg-image" aria-hidden="true"></div>
  <div class="hero-bg-logo plx" data-spd="0.12" aria-hidden="true">
    <img src="/dynasty-hero-logo.png" alt="" />
  </div>
  <div class="hero-bg-lines"></div>
  <div class="hero-top">
    <div class="hero-headline">
      <h1 class="hero-h1">
        We build <span class="hero-accent">brands</span> that lead
      </h1>
      <div class="hero-sub-area">
        <div class="hero-desc-spacer" aria-hidden="true"></div>
        <div class="hero-cta-group">
          <a href="/contact" class="btn-hero"><span>Schedule a Call</span></a>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-bottom">
    <div class="hero-stats">
      <div>
        <div class="hstat-num">10<span class="hero-accent">+</span></div>
        <div class="hstat-lab">Clients</div>
      </div>
      <div>
        <div class="hstat-num">7<span class="hero-accent">+</span></div>
        <div class="hstat-lab">Years of Experience</div>
      </div>
    </div>
    <div class="hero-scroll-hint">
      <div class="scroll-track"></div>
      Scroll to explore
    </div>
  </div>
</section>
