---
interface Props {
  title: string;
  description?: string;
  page: 'home' | 'portfolio' | 'contact';
  scripts?: string[];
}

const {
  title,
  description = 'Dynasty Marketing Agency — Full-service creative and AI agency in Miami and Venezuela.',
  page,
  scripts = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? canonical.origin;
const ogImage = `${siteOrigin}/hero-image.png`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>D</text></svg>" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/tokens.css" />
    {page !== 'home' && <link rel="stylesheet" href="/styles/portfolio.css" />}
    <link rel="stylesheet" href="/styles/responsive.css" />
    <link rel="stylesheet" href="/styles/site.css" />
  </head>
  <body class={`dynasty-site dynasty-page-${page}`}>
    <div class="cur" id="cur"></div>
    <div class="cur-ring" id="curRing"></div>
    <slot />
    <script is:inline src="/scripts/cursor.js"></script>
    {scripts.map((src) => <script is:inline src={src} />)}
  </body>
</html>
